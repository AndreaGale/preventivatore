      "type": "string",
      "description": "Codice univoco materiale"
    },
    "material_name": {
      "type": "string",
      "description": "Nome del materiale (es. PETG, PLA, ASA)"
    },
    "brand": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "spool_weight": {
      "type": "number",
      "description": "Peso bobina in grammi"
    },
    "price_tiers": {
      "type": "array",
      "description": "Scaglioni di prezzo: lista ordinata per quantit\u00e0 crescente",
      "items": {
        "type": "object",
        "properties": {
          "min_spools": {
            "type": "number",
            "description": "Numero minimo di bobine per avere questo prezzo"
          },
          "price_per_spool": {
            "type": "number",
            "description": "Prezzo per bobina a questo scaglione (\u20ac)"
          },
          "price_per_gram": {
            "type": "number",
            "description": "Prezzo al grammo a questo scaglione (\u20ac)"
          }
        }
      }
    },
    "price_per_gram": {
      "type": "number",
      "description": "Prezzo al grammo di default (scaglione 1 bobina) in \u20ac"
    }
  },
  "required": [
    "code",
    "material_name",
    "price_per_gram"
  ]
}