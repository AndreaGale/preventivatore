{
  "name": "Quote",
  "type": "object",
  "properties": {
    "quote_number": {
      "type": "number"
    },
    "client_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "payment_terms": {
      "type": "string"
    },
    "validity_days": {
      "type": "number",
      "default": 30
    },
    "status": {
      "type": "string",
      "enum": [
        "bozza",
        "inviato",
        "accettato",
        "rifiutato"
      ],
      "default": "bozza"
    },
    "setup_points": {
      "type": "number",
      "description": "Punti attrezzaggio e preparazione file (15\u20ac/punto)",
      "default": 0
    },
    "dedicated_scenario": {
      "type": "object",
      "description": "Scenario macchine dedicate per il report costi",
      "properties": {
        "enabled": { "type": "boolean" },
        "printers": { "type": "number", "description": "Stampanti nuove dedicate all'ordine" },
        "hours_per_day": { "type": "number", "description": "Ore di lavoro al giorno delle macchine dedicate" },
        "writeoff": { "type": "boolean", "description": "true = costo macchine tutto sull'ordine; false = solo usura ore usate" }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_name": {
            "type": "string"
          },
          "material_code": {
            "type": "string"
          },
          "weight_g": {
            "type": "number"
          },
          "print_time_min": {
            "type": "number"
          },
          "labor_time_min": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "manual_price": {
            "type": "number"
          },
          "partner_discount": {
            "type": "boolean",
            "description": "Sconto partner -15%"
          },
          "continuoativo_discount": {
            "type": "boolean",
            "description": "Sconto collaborazione continuativa -30%"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_name"
  ]
}