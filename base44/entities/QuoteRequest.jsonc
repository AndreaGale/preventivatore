{
  "name": "QuoteRequest",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "vat_number": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "nuova",
        "in_lavorazione",
        "preventivata",
        "chiusa"
      ],
      "default": "nuova"
    },
    "components": {
      "type": "array",
      "description": "Lista componenti richiesti",
      "items": {
        "type": "object",
        "properties": {
          "file_url": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "material_code": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "quality": {
            "type": "string",
            "enum": [
              "prototipo",
              "classico",
              "alta_qualita"
            ]
          },
          "performance": {
            "type": "string",
            "enum": [
              "fast",
              "classico",
              "performance",
              "meccanico"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "general_notes": {
      "type": "string"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email"
  ]
}